{
  "name": "stig-viewer-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && trunk serve",
    "build": "cd frontend && trunk build --release",
    "lint": "cd frontend && cargo clippy --target wasm32-unknown-unknown -- -D warnings",
