{
  "realm": "stig-viewer-dev",
  "enabled": true,
  "displayName": "STIG Viewer (dev)",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    { "name": "stig-admins" },
    { "name": "stig-editors" },
    { "name": "stig-viewers" }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "groups": ["/stig-admins"]
    },
    {
      "username": "editor",
      "email": "editor@local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Editor",
      "credentials": [
        { "type": "password", "value": "editor", "temporary": false }
      ],
      "groups": ["/stig-editors"]
    },
    {
      "username": "viewer",
      "email": "viewer@local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Viewer",
      "credentials": [
        { "type": "password", "value": "viewer", "temporary": false }
      ],
      "groups": ["/stig-viewers"]
    }
  ],
  "clients": [
    {
      "clientId": "stig-viewer-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-not-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8080/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
