# ─── Copy to `.env` and fill in values for local development ───────────────
# `.env` is git-ignored; never commit real secrets.

# ─── Postgres (docker-compose) ─────────────────────────────────────────────
POSTGRES_DB=stig_viewer
POSTGRES_USER=stig
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# ─── Backend (Rust / Axum) ─────────────────────────────────────────────────
# Required. The backend fails fast if DATABASE_URL is missing.
DATABASE_URL=postgres://stig:change-me-dev-only@localhost:5432/stig_viewer

# Optional. Defaults shown.
PORT=8080
DATA_DIR=data
STIG_SYNC_INTERVAL_HOURS=24

# Logging — tracing-subscriber EnvFilter syntax.
RUST_LOG=stig_viewer_backend=info,tower_http=info

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend API. Also interpolated into
# the production CSP `connect-src` directive and the index.html meta tag.
VITE_API_BASE_URL=http://localhost:8080
