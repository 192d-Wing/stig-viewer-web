# ─── Copy to `.env` and fill in values for local development ───────────────
# `.env` is git-ignored; never commit real secrets.

# ─── Postgres (docker-compose) ─────────────────────────────────────────────
POSTGRES_DB=stig_viewer
POSTGRES_USER=stig
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# ─── Backend (Rust / Axum) ─────────────────────────────────────────────────
# Required. The backend fails fast if DATABASE_URL is missing.
DATABASE_URL=postgres://stig:change-me-dev-only@localhost:5432/stig_viewer

# Optional. Defaults shown.
PORT=8080
DATA_DIR=data
STIG_SYNC_INTERVAL_HOURS=24

# Upload limits.
#   MAX_UPLOAD_BYTES   — single STIG ZIP (default 52428800 = 50 MiB)
#   MAX_LIBRARY_BYTES  — DISA library bundle (default 524288000 = 500 MiB)
#   UPLOAD_RATE_PER_MIN — per-IP upload requests per minute; 0 disables
MAX_UPLOAD_BYTES=52428800
MAX_LIBRARY_BYTES=524288000
UPLOAD_RATE_PER_MIN=10

# Logging — tracing-subscriber EnvFilter syntax.
RUST_LOG=stig_viewer_backend=info,tower_http=info

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend API. Also interpolated into
# the production CSP `connect-src` directive and the index.html meta tag.
VITE_API_BASE_URL=http://localhost:8080

# ─── Authentication (OIDC) ─────────────────────────────────────────────────
# The backend acts as an OIDC relying party. Set these once you have an IdP
# (Keycloak, Okta, Azure AD, etc.) available. Until they are set, auth is
# disabled and all /api routes are open — do NOT run that way in production.

# Discovery URL — the IdP's /.well-known/openid-configuration lives under this.
OIDC_ISSUER_URL=

# Client credentials issued by the IdP for this application.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Where the IdP redirects after login. Must be registered with the IdP.
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Cookie encryption key — 64 random hex chars. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Comma-separated list of IdP group claims allowed to log in. Empty = allow
# any authenticated user (not recommended for production).
ALLOWED_GROUPS=

# Role mapping: which groups map to which internal role. Group names match
# the IdP's `groups` claim exactly.
OIDC_ADMIN_GROUP=stig-admins
OIDC_EDITOR_GROUP=stig-editors
OIDC_VIEWER_GROUP=stig-viewers
