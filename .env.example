# Sample backend environment. Copy to .env (or feed into docker-compose
# via env_file) and fill in real values for the deployment.

# ── Required in production (STIG_ENV=production) ────────────────────────────

# PostgreSQL connection URL. In non-production this falls back to a local
# dev Postgres at postgres://stig:stig_local@localhost:5432/stig_viewer.
DATABASE_URL=postgres://stig:stig_local@localhost:5432/stig_viewer

# OIDC client secret issued by the IdP (Keycloak in the dev stack).
# In non-production this falls back to "dev-only-not-a-real-secret".
OIDC_CLIENT_SECRET=change-me

# ── Deployment flag ─────────────────────────────────────────────────────────

# Set to "production" to enforce the required-in-prod checks above,
# disable /api/test/* routes, and refuse SAML responses that aren't signed
# (unless SAML_INSECURE_SKIP_VERIFY=true).
STIG_ENV=development

# ── Networking + paths ──────────────────────────────────────────────────────

PORT=8080
DATA_DIR=data
FRONTEND_URL=http://localhost:5173

# ── OIDC (Keycloak in dev) ──────────────────────────────────────────────────

OIDC_INTERNAL_URL=http://keycloak:8081/realms/stig-viewer
OIDC_PUBLIC_URL=http://localhost:8081
OIDC_CLIENT_ID=stig-viewer-app
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# E2E test bypass — when set, /api/* accepts an X-User-Id header in place
# of a session cookie. Must be FALSE in production.
ALLOW_TEST_AUTH_HEADER=true

# ── SAML SP (optional) ──────────────────────────────────────────────────────

SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_CERT_PEM=
# Dev-only — skips the X.509 signature check on inbound SAML responses.
SAML_INSECURE_SKIP_VERIFY=false

# ── SMTP (optional — email is dry-run when unconfigured) ────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMPLIANCE_REPORT_RECIPIENTS=

# ── Schedulers (all hours unless noted) ─────────────────────────────────────

STIG_SYNC_INTERVAL_HOURS=24
DASHBOARD_SNAPSHOT_INTERVAL_HOURS=24
OVERDUE_DIGEST_INTERVAL_HOURS=24
AUDIT_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_ENABLED=true
COMPLIANCE_REPORT_INTERVAL_HOURS=168
COMPLIANCE_REPORT_RANGE_DAYS=30
ASSET_EMAIL_SCHEDULE_HOURS=1
